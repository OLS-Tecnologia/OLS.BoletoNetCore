<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>OLS.Lib.BoletoNetCore</PackageId>
    <!--<title>BoletoNetCore.PDF</title>-->
    <version>1.0.0</version>
    <authors>OLS Tecnologia</authors>
    <!--<owners>BoletoNetCore</owners>-->
    <!--<projectUrl>https://github.com/BoletoNet/BoletoNetCore/</projectUrl>-->
    <!--<iconUrl>https://https://avatars2.githubusercontent.com/u/10621326?v=3amp;s=200</iconUrl>-->
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <description>
      Fork da biblioteca BoletoNetCore que implementa a emissão e impressão de Boletos Bancários, geração de Arquivo de Remessa (CNAB 240 e 400) e leitura do Arquivo de Retorno (CNAB 240 e 400).                  
    </description>    
    <TargetFramework>netstandard2.0</TargetFramework>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <AssemblyVersion>25.7.9323.0</AssemblyVersion>
    <FileVersion>25.7.9323.0</FileVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <DefineConstants>NETSTANDARD2</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition=" '$(TargetFramework)' == 'netstandard2.0' ">
    <PackageReference Include="Wkhtmltopdf.NetCore" Version="1.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BoletoNetCore\OLS.BoletoNetCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Rotativa\Windows\**\*">
      <Pack>true</Pack>
      <PackagePath>contentFiles\Rotativa\Windows</PackagePath>
      <PackageCopyToOutput>true</PackageCopyToOutput>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Rotativa\Linux\**\*">
      <Pack>true</Pack>
      <PackagePath>contentFiles\Rotativa\Linux</PackagePath>
      <PackageCopyToOutput>true</PackageCopyToOutput>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>


</Project>
